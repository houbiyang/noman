@import url("unity-theme://default");

/* 弹出菜单挂在 Panel 根节点，统一在主题层覆盖，避免脱离设置面板后回到白色默认皮肤。 */
.unity-base-dropdown__container-inner { background-color:rgb(15,36,28); border-width:1px; border-color:rgb(112,124,79); border-radius:5px; padding:5px; }
.unity-base-dropdown__item { min-height:44px; color:rgb(237,241,221); background-color:rgb(15,36,28); }
.unity-base-dropdown__item-content { min-height:40px; background-color:rgb(15,36,28); }
.unity-base-dropdown__item:hover .unity-base-dropdown__item-content,
.unity-base-dropdown__item:checked .unity-base-dropdown__item-content { background-color:rgb(47,63,38); }
.unity-base-dropdown__label { color:rgb(237,241,221); font-size:16px; }
.unity-base-dropdown__checkmark { -unity-background-image-tint-color:rgb(208,190,132); }
