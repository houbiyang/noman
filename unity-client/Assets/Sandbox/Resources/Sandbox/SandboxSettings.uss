/* 设置页采用深绿指挥台配色，窄窗口将侧栏转换为顶部标签。 */
.settings-backdrop { position:absolute; left:0; right:0; top:0; bottom:0; padding:20px 0 104px; align-items:center; justify-content:center; background-color:rgba(3,14,11,0.76); }
.settings-panel { width:1160px; max-width:94%; height:100%; max-height:1040px; min-height:0; background-color:rgb(12,31,25); border-width:1px; border-color:rgb(100,119,85); border-radius:10px; overflow:hidden; color:rgb(227,233,215); }
.settings-header { flex-direction:row; align-items:center; padding:24px 28px 10px; flex-shrink:0; }
.settings-heading { flex-grow:1; flex-shrink:1; min-width:0; }
.settings-eyebrow { font-size:12px; color:rgb(169,183,145); margin:0 0 6px; padding:0; }
.settings-title { font-size:32px; -unity-font-style:bold; color:rgb(240,237,215); margin:0; padding:0; }
.settings-header-description { font-size:14px; color:rgb(157,179,160); margin:8px 0 0; padding:0; white-space:normal; }
.settings-badge { font-size:13px; color:rgb(219,205,158); background-color:rgb(42,59,37); border-width:1px; border-color:rgb(103,112,73); border-radius:12px; padding:5px 12px; margin:0 18px; white-space:nowrap; }
.settings-close { width:44px; min-height:44px; margin:0; padding:0; font-size:26px; color:rgb(206,220,193); background-color:rgb(25,48,37); border-width:1px; border-color:rgb(86,112,81); border-radius:5px; }
.settings-context { font-size:13px; color:rgb(170,188,164); padding:0 28px 18px; margin:0; border-bottom-width:1px; border-bottom-color:rgb(59,81,54); flex-shrink:0; white-space:normal; }
.settings-body { flex-direction:row; flex-grow:1; flex-shrink:1; min-height:0; }
.settings-nav { width:184px; flex-shrink:0; padding:22px 12px; background-color:rgb(10,27,22); border-right-width:1px; border-right-color:rgb(47,69,49); }
.settings-nav-caption { font-size:12px; color:rgb(123,150,127); padding:0; margin:0 12px 16px; }
.settings-nav-item { min-height:44px; margin:0 0 6px; padding:8px 14px; border-radius:5px; border-width:1px; border-color:rgba(0,0,0,0); background-color:rgba(0,0,0,0); color:rgb(164,186,162); font-size:16px; -unity-text-align:middle-left; }
.settings-nav-item:hover { background-color:rgb(27,51,37); }
.settings-nav-active { background-color:rgb(47,63,38); border-color:rgb(155,148,98); border-left-width:3px; border-left-color:rgb(218,198,137); color:rgb(239,228,183); -unity-font-style:bold; }
.settings-side-red { border-left-width:3px; border-left-color:rgb(159,95,77); }
.settings-side-blue { border-left-width:3px; border-left-color:rgb(82,135,147); }
.settings-nav-item:disabled { opacity:0.45; }
.settings-nav-note { color:rgb(126,151,128); font-size:12px; white-space:normal; margin:26px 12px 0; padding:0; }
.settings-content { flex-grow:1; flex-shrink:1; min-width:0; min-height:0; padding:24px; background-color:rgb(15,36,28); }
.settings-section-title { font-size:24px; -unity-font-style:bold; color:rgb(226,222,183); margin:0 0 8px; padding:0; }
.settings-description { font-size:14px; color:rgb(155,181,158); margin:0 0 22px; padding:0; white-space:normal; }
.settings-card { background-color:rgb(23,48,36); border-radius:6px; border-width:1px; border-color:rgb(55,82,56); padding:18px; margin:0 0 16px; flex-shrink:0; }
.settings-card-title { font-size:19px; color:rgb(229,231,202); -unity-font-style:bold; margin:0 0 10px; padding:0; white-space:normal; }
.settings-note { font-size:13px; color:rgb(148,174,151); white-space:normal; margin:5px 0; padding:0; }
.settings-log-filters { flex-direction:row; flex-wrap:wrap; margin:0 0 14px; }
.settings-log-filter { min-height:40px; margin:0 8px 8px 0; padding:7px 14px; border-width:1px; border-color:rgb(79,104,68); border-radius:4px; background-color:rgb(28,50,36); color:rgb(215,226,194); font-size:14px; }
.settings-log-filter-active { background-color:rgb(47,63,38); border-color:rgb(218,198,137); color:rgb(239,228,183); -unity-font-style:bold; }
.settings-log-line { font-size:14px; color:rgb(208,226,202); white-space:normal; padding:10px 0; border-bottom-width:1px; border-bottom-color:rgb(49,74,52); }
.settings-log-error { color:rgb(244,177,141); }
.settings-connection { padding:4px 0 12px; }
.settings-connection-state { font-size:24px; -unity-font-style:bold; color:rgb(191,211,152); margin:0 0 4px; padding:0; }
.settings-session-facts { flex-direction:row; flex-wrap:wrap; padding:10px 0; border-top-width:1px; border-top-color:rgb(50,76,52); }
.settings-session-facts .settings-fact { width:47%; margin-right:2%; }
.settings-notice { font-size:14px; color:rgb(220,218,179); background-color:rgb(38,58,35); border-left-width:3px; border-left-color:rgb(180,165,104); padding:12px; margin:8px 0 10px; white-space:normal; }
.settings-fact { flex-direction:row; margin:6px 0; }
.settings-fact-key { width:90px; flex-shrink:0; font-size:13px; color:rgb(139,167,142); white-space:normal; }
.settings-fact-value { flex-grow:1; flex-shrink:1; min-width:0; font-size:14px; color:rgb(216,229,207); white-space:normal; }
.settings-details { margin-top:10px; padding-top:8px; border-top-width:1px; border-top-color:rgb(50,76,52); }
.settings-details > .unity-foldout__toggle { min-height:36px; color:rgb(175,192,161); font-size:14px; }
.settings-grid { flex-direction:row; flex-wrap:wrap; }
.settings-field-wrap { flex-shrink:0; min-width:0; margin-bottom:14px; }
.settings-grid > .settings-field-wrap { width:47%; margin-right:2%; padding-right:0; }
.settings-grid > .settings-span-full { width:100%; margin-right:0; }
.settings-field { flex-direction:column; align-items:stretch; margin:0; font-size:16px; }
.settings-field .unity-base-field__label { color:rgb(191,209,178); font-size:14px; min-width:0; width:auto; margin:0 0 7px; padding:0; white-space:normal; }
.settings-field .unity-base-text-field__input { min-height:48px; padding:10px 12px; background-color:rgb(10,29,22); border-width:1px; border-color:rgb(66,94,64); border-radius:4px; color:rgb(237,241,221); font-size:16px; -unity-text-align:middle-left; }
.settings-field .unity-base-text-field__input:focus { border-color:rgb(202,187,120); }
.settings-field.unity-toggle { flex-direction:row; align-items:center; min-height:44px; }
.settings-field .unity-toggle__label { flex-grow:1; flex-shrink:1; margin:0 10px 0 0; }
.settings-field .unity-toggle__input { min-height:30px; min-width:30px; }
.settings-field.unity-toggle .unity-toggle__checkmark { background-color:rgb(10,29,22); border-width:1px; border-color:rgb(112,140,94); border-radius:4px; width:24px; height:24px; -unity-background-image-tint-color:rgb(226,211,158); }
.settings-field-error { font-size:13px; white-space:normal; color:rgb(242,180,139); margin:5px 0 0; padding:0; }
.settings-invalid .unity-base-text-field__input { border-color:rgb(226,157,111); border-width:2px; }
.settings-card > .unity-foldout__toggle { min-height:44px; font-size:19px; -unity-font-style:bold; color:rgb(223,229,199); margin:0; background-color:rgba(0,0,0,0); }
.settings-panel .unity-foldout__content { margin-left:0; padding-top:8px; }
.settings-panel .unity-foldout__checkmark { -unity-background-image-tint-color:rgb(187,204,159); }
.settings-model-status { font-size:12px; color:rgb(201,190,140); margin:0 0 12px; padding:0; }
.settings-agent-roles { flex-direction:row; flex-wrap:wrap; margin:4px 0 8px; }
.settings-agent-role { font-size:14px; color:rgb(202,218,181); background-color:rgb(35,62,41); border-width:1px; border-color:rgb(70,96,61); border-radius:4px; padding:7px 16px; margin:0 8px 6px 0; }
.settings-red-section .settings-section-title { color:rgb(224,181,158); }
.settings-blue-section .settings-section-title { color:rgb(174,208,203); }
.settings-display-grid { flex-direction:row; flex-wrap:wrap; }
.settings-display-grid > .settings-field-wrap { width:48%; margin-right:2%; margin-bottom:14px; min-height:116px; padding:14px; border-width:1px; border-color:rgb(64,91,62); border-radius:5px; background-color:rgb(28,55,39); }
.settings-toggle-description { font-size:13px; color:rgb(149,178,148); white-space:normal; margin-top:8px; padding:0; }
.settings-footer { flex-direction:row; align-items:center; flex-shrink:0; padding:18px 26px; border-top-width:1px; border-top-color:rgb(78,95,62); background-color:rgb(12,29,23); }
.settings-footer-copy { flex-grow:1; flex-shrink:1; min-width:0; margin-right:18px; }
.settings-save-state { font-size:15px; color:rgb(178,201,152); margin:0 0 4px; padding:0; }
.settings-unsaved { color:rgb(232,202,131); }
.settings-actions { flex-direction:row; justify-content:flex-end; flex-wrap:wrap; flex-shrink:0; }
.settings-primary, .settings-secondary { min-height:46px; margin:4px 0 0 8px; padding:10px 18px; border-radius:4px; border-width:1px; font-size:15px; }
.settings-primary { min-width:132px; background-color:rgb(208,190,132); border-color:rgb(218,203,153); color:rgb(23,41,27); -unity-font-style:bold; }
.settings-secondary { background-color:rgb(28,50,36); border-color:rgb(79,104,68); color:rgb(215,226,194); }
.settings-primary:hover { background-color:rgb(228,212,162); }
.settings-secondary:hover, .settings-close:hover { background-color:rgb(45,68,43); }
.settings-primary:disabled, .settings-secondary:disabled { opacity:0.4; }
.settings-primary:focus, .settings-secondary:focus, .settings-close:focus, .settings-nav-item:focus { border-color:rgb(221,204,143); }
.settings-panel .unity-scroller--vertical { width:14px; margin-left:10px; }
.settings-panel .unity-scroller__low-button, .settings-panel .unity-scroller__high-button { display:none; }
.settings-panel .unity-base-slider__tracker { background-color:rgb(18,43,31); border-width:0; }
.settings-panel .unity-base-slider__dragger { background-color:rgb(100,125,79); border-width:0; border-radius:6px; }

/* 窄窗口保留完整内容宽度，并提高表单与操作控件的字号。 */
.compact .settings-panel { max-width:96%; height:100%; max-height:1500px; }
.compact .settings-header { padding:20px 24px 10px; }
.compact .settings-eyebrow { font-size:16px; }
.compact .settings-header-description { font-size:18px; }
.compact .settings-badge { display:none; }
.compact .settings-context { font-size:17px; padding:0 24px 16px; }
.compact .settings-body { flex-direction:column; }
.compact .settings-nav { width:auto; flex-direction:row; flex-wrap:wrap; padding:12px 16px; border-right-width:0; border-bottom-width:1px; border-bottom-color:rgb(58,79,51); }
.compact .settings-nav-caption, .compact .settings-nav-note { display:none; }
.compact .settings-nav-item { flex-grow:1; width:19%; min-height:60px; margin:0 4px 0 0; padding:10px 6px; font-size:18px; -unity-text-align:middle-center; }
.compact .settings-content { padding:22px; }
.compact .settings-section-title { font-size:26px; }
.compact .settings-description { font-size:18px; }
.compact .settings-card { padding:20px; }
.compact .settings-card-title, .compact .settings-card > .unity-foldout__toggle { font-size:22px; }
.compact .settings-note { font-size:17px; }
.compact .settings-log-filter { min-height:48px; font-size:18px; }
.compact .settings-log-line { font-size:18px; }
.compact .settings-connection { flex-direction:row; align-items:center; }
.compact .settings-connection-state { font-size:24px; flex-shrink:0; }
.compact .settings-connection .settings-note { flex-grow:1; flex-shrink:1; min-width:0; margin-left:20px; }
.compact .settings-session-facts { display:none; }
.compact .settings-fact-key { font-size:18px; width:108px; }
.compact .settings-fact-value { font-size:20px; }
.compact .settings-details > .unity-foldout__toggle { font-size:18px; min-height:44px; }
.compact .settings-field .unity-base-field__label { font-size:20px; }
.compact .settings-field .unity-base-text-field__input { min-height:60px; font-size:20px; }
.compact .settings-field.unity-toggle { min-height:52px; }
.compact .settings-field-error, .compact .settings-model-status { font-size:17px; }
.compact .settings-agent-role { font-size:18px; }
.compact .settings-toggle-description { font-size:17px; }
.compact .settings-footer { flex-direction:column; align-items:stretch; padding:16px 22px; }
.compact .settings-footer-copy { margin:0 0 8px; }
.compact .settings-save-state { font-size:20px; }
.compact .settings-footer .settings-note { font-size:16px; }
.compact .settings-actions { justify-content:flex-end; }
.compact .settings-primary, .compact .settings-secondary { min-height:56px; font-size:20px; }
.compact .settings-primary { min-width:180px; }
.compact .settings-close { width:52px; min-height:52px; }

/* 军队抽屉继续沿用现有滚动条样式。 */
.army-panel .unity-scroller--vertical { width:12px; margin-left:8px; }
.army-panel .unity-scroller__low-button, .army-panel .unity-scroller__high-button { display:none; }
.army-panel .unity-base-slider__tracker { background-color:rgb(28,42,55); border-width:0; }
.army-panel .unity-base-slider__dragger { background-color:rgb(84,110,131); border-width:0; border-radius:6px; }

.settings-field.unity-toggle .unity-toggle__checkmark { background-color:rgb(13,22,31); border-width:1px; border-color:rgb(107,135,156); border-radius:4px; width:24px; height:24px; -unity-background-image-tint-color:rgb(224,238,246); }

/* 结果审计沿用设置页字体，卡片内容不压缩。 */
.result-hero { border-top-width:3px; border-top-color:rgb(161,198,207); background-color:rgb(27,44,55); }
.result-verdict { font-size:24px; -unity-font-style:bold; color:rgb(225,241,243); margin:4px 0; white-space:normal; }
.result-score { font-size:36px; -unity-font-style:bold; color:rgb(169,216,222); margin:4px 0 12px; }
.result-calculation { font-size:14px; white-space:normal; color:rgb(222,234,242); padding:12px 8px; margin:0 0 8px; border-left-width:3px; border-left-color:rgb(100,139,161); background-color:rgb(20,30,40); flex-shrink:0; }
.result-milestone { font-size:14px; white-space:normal; color:rgb(189,216,221); margin:0 0 12px; padding:4px 0; flex-shrink:0; }
