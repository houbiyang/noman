/* 历史与结果嵌入设置内容区，共用深绿指挥台、居中大面板与背景遮罩。 */
.settings-report-content .report-heading { margin-bottom:20px; flex-shrink:0; }
.report-eyebrow { color:rgb(169,183,145); font-size:12px; margin:0 0 8px; padding:0; white-space:normal; }
.report-title { font-size:24px; -unity-font-style:bold; color:rgb(226,222,183); margin:0 0 8px; padding:0; white-space:normal; }
.report-description { color:rgb(155,181,158); font-size:14px; margin:0; padding:0; white-space:normal; }
.report-muted { color:rgb(157,179,160); font-size:13px; margin:4px 0; padding:0; white-space:normal; }
.report-card { background-color:rgb(23,48,36); border-width:1px; border-color:rgb(55,82,56); border-radius:6px; padding:18px; margin-bottom:16px; flex-shrink:0; min-width:0; }
.report-card-title { font-size:19px; -unity-font-style:bold; color:rgb(229,231,202); padding:0; margin:0 0 10px; white-space:normal; }
.report-overview { flex-direction:row; flex-wrap:wrap; margin-right:-12px; flex-shrink:0; }
.report-summary { flex-basis:180px; flex-grow:1; margin-right:12px; }
.report-stat { color:rgb(219,205,158); font-size:26px; -unity-font-style:bold; margin:8px 0; padding:0; white-space:normal; }
.report-toolbar { flex-direction:row; flex-wrap:wrap; align-items:center; margin:4px 0 12px; flex-shrink:0; }
.report-button, .report-primary, .report-link { min-height:44px; padding:9px 16px; margin:4px 10px 4px 0; border-radius:5px; border-width:1px; font-size:15px; white-space:normal; }
.report-button { background-color:rgb(25,48,37); border-color:rgb(79,104,68); color:rgb(215,226,194); }
.report-primary { background-color:rgb(208,190,132); border-color:rgb(208,190,132); color:rgb(23,41,27); -unity-font-style:bold; }
.report-button:hover { background-color:rgb(45,68,43); }
.report-selected { background-color:rgb(47,63,38); border-color:rgb(155,148,98); color:rgb(239,228,183); }
.report-primary:hover { background-color:rgb(228,212,162); }
.report-button:focus, .report-primary:focus, .report-link:focus { border-color:rgb(221,204,143); }
.report-button:disabled, .report-primary:disabled, .report-link:disabled { opacity:0.4; }
.report-link { background-color:rgba(0,0,0,0); border-color:rgb(79,104,68); color:rgb(219,205,158); padding:8px 12px; }
.report-link:hover { background-color:rgb(45,68,43); }
.report-name { width:280px; max-width:100%; margin-right:12px; margin-bottom:8px; }
.report-search { width:260px; max-width:100%; }
.report-notice { background-color:rgb(35,53,36); border-left-width:3px; border-left-color:rgb(186,169,107); color:rgb(218,216,181); font-size:14px; padding:12px; margin:8px 0 16px; white-space:normal; flex-shrink:0; }
.archive-horizontal { flex-shrink:0; min-height:130px; }
.archive-table { min-width:1000px; flex-grow:1; }
.archive-row { flex-direction:row; align-items:center; padding:16px 0; border-bottom-width:1px; border-bottom-color:rgb(47,69,49); flex-shrink:0; }
.archive-head { background-color:rgb(15,36,28); padding:12px 0; }
.archive-head .archive-cell { font-size:13px; color:rgb(157,179,160); }
.archive-cell { font-size:14px; white-space:normal; padding:0 10px; margin:0; color:rgb(215,226,194); flex-shrink:0; }
.archive-title-cell { flex-grow:1; flex-basis:250px; min-width:250px; padding:0 12px; flex-shrink:0; }
.archive-name { font-size:16px; color:rgb(229,231,202); margin:0 0 4px; padding:0; white-space:normal; }
.archive-type-cell { width:140px; }
.archive-date-cell { width:150px; }
.archive-step-cell { width:90px; }
.archive-state-cell { width:150px; color:rgb(187,207,149); }
.archive-action-cell { width:145px; padding-left:10px; }
.archive-empty { padding:28px 12px; color:rgb(157,179,160); font-size:14px; white-space:normal; }
.report-result-hero { flex-direction:row; align-items:center; flex-wrap:wrap; }
.report-seal { width:64px; height:64px; border-radius:32px; background-color:rgb(42,59,37); align-items:center; justify-content:center; margin:0 16px 12px 0; }
.report-seal-icon { width:44px; height:44px; background-image:url("project://database/Assets/Sandbox/Resources/Sandbox/Icons/Battle.png"); -unity-background-scale-mode:scale-to-fit; margin:0; padding:0; }
.report-victory { flex-grow:1; flex-basis:180px; min-width:160px; margin:0 12px 12px 0; }
.report-verdict { font-size:28px; -unity-font-style:bold; color:rgb(219,205,158); margin:0 0 8px; padding:0; white-space:normal; }
.report-score-red, .report-score-blue { width:155px; align-items:center; justify-content:center; background-color:rgb(15,36,28); margin:8px 0; padding:16px 10px; }
.report-score-number { font-size:28px; -unity-font-style:bold; margin:4px 0; padding:0; }
.report-score-red .report-score-number { color:rgb(203,151,131); }
.report-score-blue .report-score-number { color:rgb(163,199,191); }
.report-versus { color:rgb(157,179,160); font-size:16px; margin:0 12px; }
.report-score-summary { font-size:14px; color:rgb(157,179,160); padding:0; margin:0 0 18px; flex-shrink:0; }
.report-result-grid { flex-direction:column; flex-shrink:0; }
.report-breakdown, .report-decisions { flex-shrink:0; }
.report-bar-row { flex-direction:row; align-items:center; margin:8px 0 16px; }
.report-bar-label { font-size:14px; width:40px; padding:0; margin:0; }
.report-bar-track { flex-grow:1; height:8px; background-color:rgb(13,29,23); border-radius:4px; overflow:hidden; }
.report-red-bar { background-color:rgb(203,151,131); }
.report-blue-bar { background-color:rgb(163,199,191); }
.report-bar-value { width:70px; font-size:14px; color:rgb(215,226,194); -unity-text-align:middle-right; padding:0; margin:0 0 0 8px; }
.report-timeline { border-left-width:3px; border-left-color:rgb(100,125,79); background-color:rgb(15,36,28); padding:14px 16px; margin:4px 0 10px; font-size:14px; color:rgb(215,226,194); white-space:normal; }
.report-calculation { border-bottom-width:1px; border-bottom-color:rgb(47,69,49); padding:16px 0; margin:0 0 8px; color:rgb(215,226,194); font-size:14px; white-space:normal; }
.compact .report-title { font-size:26px; }
.compact .report-description, .compact .report-muted, .compact .report-notice, .compact .report-calculation, .compact .report-timeline { font-size:17px; }
.compact .report-card-title { font-size:22px; }
.compact .report-button, .compact .report-primary, .compact .report-link { min-height:52px; font-size:18px; }
.compact .report-summary { flex-basis:220px; }

/* 合并来源与状态操作：与指挥台输入框一致，不再铺满切换按钮。 */
.report-select { width:300px; min-width:260px; max-width:100%; margin:0 16px 8px 0; flex-shrink:1; }
.report-select .unity-base-popup-field__input { min-height:48px; padding:10px 12px; background-color:rgb(10,29,22); border-width:1px; border-color:rgb(66,94,64); border-radius:4px; color:rgb(237,241,221); font-size:16px; }
.report-select .unity-base-popup-field__input:focus { border-color:rgb(202,187,120); }
.report-select .unity-base-popup-field__text { color:rgb(237,241,221); white-space:normal; }
.report-select .unity-base-popup-field__arrow { -unity-background-image-tint-color:rgb(208,190,132); }
.compact .report-select .unity-base-popup-field__input { min-height:52px; font-size:18px; }
