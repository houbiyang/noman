.army-panel { position:absolute; right:18px; top:104px; bottom:136px; width:398px; max-width:90%; background-color:rgb(18,26,35); border-radius:8px; overflow:hidden; border-width:1px; border-color:rgb(66,82,97); color:rgb(231,237,242); }
.army-header { flex-direction:row; align-items:center; flex-shrink:0; padding:12px 16px; border-bottom-width:1px; border-bottom-color:rgb(51,66,81); }
.army-title { color:rgb(231,237,242); font-size:24px; -unity-font-style:bold; }
.army-close { width:44px; min-height:44px; margin:0; padding:0; border-radius:6px; background-color:rgb(37,49,62); color:rgb(224,234,242); font-size:26px; border-width:1px; border-color:rgb(77,95,110); }
.army-toolbar { flex-direction:row; align-items:center; flex-shrink:0; padding:8px 12px; background-color:rgb(25,36,47); }
.army-side { color:rgb(215,228,240); font-size:14px; -unity-font-style:bold; margin-right:8px; }
.army-switch { background-color:rgb(35,49,62); color:rgb(226,238,246); border-width:1px; border-color:rgb(79,104,124); border-radius:6px; padding:8px; margin:0; font-size:12px; min-height:44px; }
.army-scroll { flex-grow:1; flex-shrink:1; min-height:0; }
.army-cards { padding:12px 12px 0; }
.army-card { flex-direction:row; flex-shrink:0; margin-bottom:12px; padding:12px; background-color:rgb(25,36,47); border-radius:8px; border-width:1px; border-color:rgb(53,71,88); }
.army-stage { width:104px; height:116px; flex-shrink:0; background-color:rgb(13,22,31); border-radius:6px; overflow:hidden; margin-right:12px; }
.army-model { width:100%; height:100%; }
.army-card-details { flex-grow:1; min-width:0; }
.army-card-title { color:rgb(230,238,245); font-size:18px; -unity-font-style:bold; white-space:normal; margin:0; padding:0; }
.army-troop-name { font-size:12px; color:rgb(168,188,204); margin:4px 0; white-space:normal; }
.army-current { font-size:12px; color:rgb(181,199,211); margin:4px 0 8px; padding:0; white-space:normal; }
.army-deploy { min-height:44px; margin:0; padding:8px; font-size:14px; color:rgb(226,238,246); background-color:rgb(35,49,62); border-width:1px; border-color:rgb(79,104,124); border-radius:6px; }
.army-deploy:hover, .army-switch:hover, .army-secondary:hover { background-color:rgb(51,72,90); }
.army-footer { flex-shrink:0; padding:12px 16px; background-color:rgb(21,31,41); border-top-width:1px; border-top-color:rgb(58,77,93); }
.army-footnote { font-size:12px; color:rgb(164,184,200); margin-top:4px; white-space:normal; }
.army-command { position:absolute; left:18px; right:434px; top:104px; flex-direction:row; align-items:center; padding:12px; background-color:rgb(21,31,41); border-radius:8px; border-width:1px; border-color:rgb(115,163,188); }
.army-command-title { font-size:18px; color:rgb(231,237,242); -unity-font-style:bold; white-space:normal; }
.army-command-detail { font-size:12px; color:rgb(168,188,204); margin-top:4px; white-space:normal; }
.army-secondary { background-color:rgb(35,49,62); border-width:1px; border-color:rgb(79,104,124); color:rgb(226,238,246); min-height:44px; padding:8px 16px; border-radius:6px; margin-left:12px; }
.army-card-selected { border-color:rgb(139,193,216); background-color:rgb(32,49,64); }
