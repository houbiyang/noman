.army-overlay { position:absolute; left:0; top:0; right:0; bottom:0; background-color:rgba(16,26,23,0.78); align-items:center; justify-content:center; padding:28px; }
.army-panel { width:1180px; max-width:100%; max-height:94%; background-color:rgb(236,236,223); border-radius:18px; overflow:hidden; border-width:1px; border-color:rgb(150,160,137); }
.army-header { flex-direction:row; align-items:center; padding:24px 28px 20px; background-color:rgb(232,233,218); border-bottom-width:1px; border-bottom-color:rgb(199,205,181); }
.army-eyebrow { color:rgb(104,119,83); font-size:11px; letter-spacing:2px; margin-bottom:3px; }
.army-title { color:rgb(37,53,40); font-size:34px; -unity-font-style:bold; }
.army-subtitle { color:rgb(104,114,97); font-size:13px; margin-top:4px; }
.army-close { width:44px; height:44px; border-radius:12px; background-color:rgb(216,222,201); color:rgb(56,75,48); font-size:30px; border-width:0; }
.army-toolbar { flex-direction:row; align-items:center; padding:12px 28px; background-color:rgb(49,65,49); }
.army-side { color:rgb(233,238,220); font-size:15px; -unity-font-style:bold; margin-right:16px; }
.army-capacity { color:rgb(185,199,167); font-size:12px; -unity-text-align:middle-right; }
.army-switch { background-color:rgb(76,93,65); color:rgb(237,240,226); border-width:0; border-radius:5px; padding:6px 12px; }
.army-scroll { flex-shrink:1; min-height:180px; }
.army-cards { flex-direction:row; padding:20px 20px 22px; }
.army-card { flex-grow:1; flex-basis:0; min-width:0; margin:0 7px; padding:16px; background-color:rgb(248,247,235); border-radius:12px; border-width:1px; border-color:rgb(202,208,183); }
.army-card-top { flex-direction:row; }
.army-card-tag { color:rgb(118,133,90); font-size:10px; letter-spacing:2px; margin-bottom:6px; }
.army-card-title { color:rgb(44,57,43); font-size:23px; -unity-font-style:bold; margin-bottom:8px; white-space:normal; }
.army-stage { height:184px; background-color:rgb(33,46,46); border-radius:9px; overflow:hidden; margin-bottom:12px; }
.army-model { flex-grow:1; width:100%; }
.army-model-caption { position:absolute; bottom:9px; left:12px; font-size:10px; color:rgb(180,197,166); }
.army-description { color:rgb(97,108,87); font-size:12px; white-space:normal; height:48px; }
.army-current { font-size:11px; color:rgb(113,126,95); margin-top:8px; margin-bottom:10px; }
.army-quantity { flex-direction:row; align-items:center; background-color:rgb(231,233,216); border-radius:8px; padding:6px; margin-bottom:12px; }
.army-stepper { width:40px; height:44px; font-size:25px; color:rgb(61,80,44); background-color:rgb(248,249,237); border-width:1px; border-color:rgb(192,202,166); border-radius:6px; }
.army-stepper:disabled { opacity:0.3; }
.army-stepper:hover, .army-secondary:hover { background-color:rgb(210,223,181); }
.army-quantity-value { flex-grow:1; align-items:center; }
.army-number { font-size:28px; color:rgb(44,63,34); -unity-font-style:bold; }
.army-number-hint { font-size:10px; color:rgb(125,138,106); }
.army-deploy { height:40px; font-size:14px; color:rgb(245,248,231); background-color:rgb(78,99,54); border-width:0; border-radius:7px; -unity-font-style:bold; }
.army-deploy:hover, .army-primary:hover { background-color:rgb(100,127,63); }
.army-footer { flex-direction:row; align-items:center; padding:18px 28px; background-color:rgb(219,225,200); border-top-width:1px; border-top-color:rgb(190,200,165); }
.army-total { font-size:19px; color:rgb(47,66,37); -unity-font-style:bold; }
.army-footnote { font-size:11px; color:rgb(107,122,90); margin-top:5px; white-space:normal; max-width:550px; }
.army-secondary { background-color:rgb(237,239,222); border-width:1px; border-color:rgb(179,192,150); color:rgb(73,93,51); padding:11px 20px; border-radius:7px; margin-left:10px; }
.army-primary { background-color:rgb(67,91,43); border-width:0; color:rgb(245,247,229); padding:12px 26px; margin-left:12px; border-radius:7px; font-size:15px; -unity-font-style:bold; }
.army-command { position:absolute; top:120px; align-self:center; flex-direction:row; align-items:center; padding:15px 20px; background-color:rgb(43,61,43); border-radius:10px; border-width:1px; border-color:rgb(147,167,103); }
.army-command-title { font-size:18px; color:rgb(236,241,217); -unity-font-style:bold; }
.army-command-detail { font-size:12px; color:rgb(172,191,145); margin-top:5px; }
.compact .army-title { font-size:28px; }
.compact .army-header { padding-top:16px; padding-bottom:14px; }
.compact .army-card-title { font-size:20px; }
.compact .army-stage { height:160px; }
