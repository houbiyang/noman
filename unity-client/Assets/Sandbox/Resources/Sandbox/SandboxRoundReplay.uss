.recorded-card {
    width: 94%; height: 90%; max-width: 1540px; max-height: 1000px;
    background-color: rgb(14, 35, 32); color: rgb(218, 229, 213);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgb(93, 122, 97); border-right-color: rgb(93, 122, 97); border-top-color: rgb(93, 122, 97); border-bottom-color: rgb(93, 122, 97);
    border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;
    padding-left: 20px; padding-right: 20px; padding-top: 14px; padding-bottom: 14px;
}
.recorded-row { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 6px; flex-shrink: 0; }
.recorded-title { font-size: 22px; -unity-font-style: bold; flex-grow: 1; }
.recorded-note { color: rgb(159, 184, 165); font-size: 12px; white-space: normal; margin-bottom: 6px; flex-shrink: 0; }
.recorded-row .unity-base-field { min-width: 145px; margin-right: 8px; }
.recorded-row .unity-base-field__label { min-width: 36px; }
.recorded-body { flex-direction: row; flex-grow: 1; min-height: 130px; margin-bottom: 8px; }
.recorded-view-wrap { flex-grow: 1; flex-basis: 0; overflow: hidden; background-color: rgb(5, 16, 16); margin-right: 12px; }
.recorded-viewport { width: 100%; height: 100%; }
.recorded-annotations { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.recorded-sidebar { width: 280px; flex-shrink: 0; }
.recorded-score { font-size: 14px; -unity-font-style: bold; margin-bottom: 8px; white-space: normal; }
.recorded-facts { flex-grow: 1; }
.recorded-point { background-color: rgb(23, 48, 41); padding-top: 6px; padding-bottom: 6px; padding-left: 8px; margin-bottom: 5px; font-size: 12px; white-space: normal; }
.recorded-unit { -unity-text-align: middle-left; white-space: normal; padding-left: 8px; padding-right: 8px; padding-top: 7px; padding-bottom: 7px; margin-bottom: 6px; background-color: rgb(22, 43, 39); font-size: 12px; }
.recorded-map-label { position: absolute; max-width: 205px; white-space: normal; font-size: 10px; background-color: rgba(5, 20, 19, .87); padding-left: 5px; padding-right: 5px; padding-top: 3px; padding-bottom: 3px; }
.recorded-blue { color: rgb(146, 206, 241); }
.recorded-red { color: rgb(245, 162, 137); }
.recorded-clock { flex-grow: 1; -unity-text-align: middle-right; font-size: 12px; }
.compact .recorded-card { width: 97%; height: 94%; padding-left: 12px; padding-right: 12px; }
.compact .recorded-sidebar { width: 235px; }
