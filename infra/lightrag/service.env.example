# 复制由 manage.py init 完成；模型配置必须分别填写两份 service.env。
LIGHTRAG_API_KEY=__GENERATED_PER_SIDE__
LLM_BINDING=openai
LLM_BINDING_HOST=__LLM_BASE_URL__
LLM_BINDING_API_KEY=__LLM_API_KEY__
LLM_MODEL=__LLM_MODEL__
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=__EMBEDDING_BASE_URL__
EMBEDDING_BINDING_API_KEY=__EMBEDDING_API_KEY__
EMBEDDING_MODEL=__EMBEDDING_MODEL__
EMBEDDING_DIM=__EMBEDDING_DIM__
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false
EMBEDDING_USE_BASE64=false
EMBEDDING_BATCH_NUM=8
EMBEDDING_FUNC_MAX_ASYNC=2
MAX_ASYNC_LLM=2
MAX_PARALLEL_INSERT=1
LLM_TIMEOUT=45
EMBEDDING_TIMEOUT=30
SUMMARY_LANGUAGE=Chinese
RERANK_BINDING=null
RERANK_BY_DEFAULT=false
ENABLE_LLM_CACHE=false
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
# 管理界面也以 X-API-Key 认证；不设置免认证路径，不启用公开用户注册。
# 不在上游常规日志记录查询/原文；调试前先使用脱敏临时语料。
LOG_LEVEL=CRITICAL
VERBOSE=false
